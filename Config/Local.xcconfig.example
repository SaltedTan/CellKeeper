// Copy to Config/Local.xcconfig (git-ignored) to override signing and
// identity for your own builds. Never commit Local.xcconfig.

// Your reverse-DNS prefix, e.g. io.github.yourname
// CELLKEEPER_BUNDLE_ID_PREFIX = io.github.yourname

// Your Apple Developer team ID and signing identity.
// DEVELOPMENT_TEAM = ABCDE12345
// CODE_SIGN_IDENTITY = Apple Development

// The power flow's SMC reader (docs/research/13-smc-power-reads.md §6.6),
// off by default. YES compiles CellKeeper/SMC/SMCPowerReader.swift and signs
// the app with Config/CellKeeper-SMC.entitlements, which adds a sandbox
// exception for the SMC's user client. The reader is the owner's (note 13
// §6.1), untried until note 13's O3 trial. One-off builds can instead pass
// CELLKEEPER_SMC_READER=YES on the xcodebuild command line.
// CELLKEEPER_SMC_READER = YES
