// Project-wide build settings for CellKeeper.
//
// To use your own signing identity or bundle identifier, copy
// Config/Local.xcconfig.example to Config/Local.xcconfig (git-ignored) and
// edit it there. Do not commit team IDs or personal identifiers.

// Reverse-DNS prefix based on the maintainer's GitHub Pages domain
// (saltedtan.github.io). Forks distributing their own builds should use their
// own prefix via Config/Local.xcconfig.
CELLKEEPER_BUNDLE_ID_PREFIX = io.github.saltedtan

MACOSX_DEPLOYMENT_TARGET = 14.0
SDKROOT = macosx
SWIFT_VERSION = 6.0

// Contributors can build without an Apple Developer account: binaries are
// ad-hoc signed ("Sign to Run Locally"). Maintainers override these in
// Local.xcconfig.
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
ENABLE_HARDENED_RUNTIME = YES

ENABLE_USER_SCRIPT_SANDBOXING = YES
ENABLE_MODULE_VERIFIER = NO
DEAD_CODE_STRIPPING = YES
LOCALIZATION_PREFERS_STRING_CATALOGS = YES

// The power flow's SMC reader (research note 13 §6.6, architecture D115):
// off by default. Only YES turns it on, and then it selects the SMC
// entitlements file and compiles the reader (Config/CellKeeper.xcconfig).
// Set it here, at project level and above the include, so that the owner's
// Local.xcconfig can set YES after it; CI sets it on the xcodebuild command
// line, which takes precedence over both files.
CELLKEEPER_SMC_READER = NO

#include? "Local.xcconfig"
