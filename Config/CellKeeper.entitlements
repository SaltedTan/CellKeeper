<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Milestone 1 only reads telemetry, which works inside the App Sandbox.
	     See docs/research/05-distribution-and-signing.md before adding
	     entitlements. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
