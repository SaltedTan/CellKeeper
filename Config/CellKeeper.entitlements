<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Everything CellKeeper does works inside the App Sandbox: reading
	     telemetry, and launching /usr/bin/shortcuts and /usr/bin/pmset for
	     macOS's Charge Limit (research note 08, O3). See
	     docs/research/05-distribution-and-signing.md before adding
	     entitlements; CI checks that the signed app carries exactly these. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- For Settings › Activity › Save Diagnostics…: CellKeeper may show
	     a save panel and write the file the user chooses there. It grants
	     access only to files the user picks in an open or save panel, and
	     CellKeeper shows no other (docs/architecture.md, D76). -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
